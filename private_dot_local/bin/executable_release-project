#!/bin/sh
# release-project: build/tag/push a container image for a project defined in
# ./releaseable.yml, then git-tag the commit as <project>/vX.Y.Z.
#
# Usage:
#   release-project <project> [--major | --minor] [--force-other-branch] [--force-dirty]
#   release-project --list
#   release-project --help

set -e

REGISTRY_HOST="rg.fr-par.scw.cloud"
DEFAULT_NAMESPACE="ioan-pari"
CONFIG_FILE="releaseable.yml"

usage() {
  cat <<'EOF'
Usage:
  release-project <project> [--major | --minor] [--force-other-branch] [--force-dirty]
  release-project --list                    list projects in ./releaseable.yml
  release-project --help                    this message

Flags:
  --major                bump X.Y.Z -> (X+1).0.0
  --minor                bump X.Y.Z -> X.(Y+1).0
  (none)                 bump X.Y.Z -> X.Y.(Z+1)
  --force-other-branch   allow release from non-default branch
  --force-dirty          allow release with uncommitted/untracked files

Config (./releaseable.yml):
  projects:
    <project>:
      container:  <image name>         (default: <project>)
      namespace:  <registry namespace> (default: ioan-pari)
      dockerfile: <path>               (default: ./<project>/Dockerfile)
      context:    <path>               (default: dirname of dockerfile)
EOF
}

require_yq() {
  if ! command -v yq >/dev/null 2>&1; then
    echo "Error: 'yq' is required but not installed. Install with e.g. 'pacman -S go-yq'." >&2
    exit 1
  fi
}

require_config() {
  if [ ! -f "$CONFIG_FILE" ]; then
    echo "Error: $CONFIG_FILE not found in $(pwd)." >&2
    exit 1
  fi
}

list_projects() {
  require_yq
  require_config
  yq eval '.projects | keys | .[]' "$CONFIG_FILE"
}

# --- arg parse ---

PROJECT=""
BUMP=patch
FORCE_OTHER_BRANCH=0
FORCE_DIRTY=0

for arg in "$@"; do
  case "$arg" in
    --help|-h)
      usage; exit 0 ;;
    --list)
      list_projects; exit 0 ;;
    --major)
      [ "$BUMP" = patch ] || { echo "Error: --major and --minor are mutually exclusive" >&2; exit 1; }
      BUMP=major ;;
    --minor)
      [ "$BUMP" = patch ] || { echo "Error: --major and --minor are mutually exclusive" >&2; exit 1; }
      BUMP=minor ;;
    --force-other-branch)
      FORCE_OTHER_BRANCH=1 ;;
    --force-dirty)
      FORCE_DIRTY=1 ;;
    --*)
      echo "Unknown flag: $arg" >&2; exit 1 ;;
    *)
      if [ -n "$PROJECT" ]; then
        echo "Error: multiple project names given ('$PROJECT', '$arg')." >&2
        exit 1
      fi
      PROJECT="$arg" ;;
  esac
done

if [ -z "$PROJECT" ]; then
  usage >&2
  exit 1
fi

require_yq
require_config

# --- resolve project config ---

if ! yq eval ".projects | has(\"$PROJECT\")" "$CONFIG_FILE" | grep -q '^true$'; then
  echo "Error: project '$PROJECT' not in $CONFIG_FILE. Available:" >&2
  yq eval '.projects | keys | .[]' "$CONFIG_FILE" | sed 's/^/  - /' >&2
  exit 1
fi

CONTAINER=$(yq eval ".projects.\"$PROJECT\".container // \"$PROJECT\"" "$CONFIG_FILE")
NAMESPACE=$(yq eval ".projects.\"$PROJECT\".namespace // \"$DEFAULT_NAMESPACE\"" "$CONFIG_FILE")
DOCKERFILE=$(yq eval ".projects.\"$PROJECT\".dockerfile // \"./$PROJECT/Dockerfile\"" "$CONFIG_FILE")
CONTEXT=$(yq eval ".projects.\"$PROJECT\".context // \"\"" "$CONFIG_FILE")
if [ -z "$CONTEXT" ] || [ "$CONTEXT" = "null" ]; then
  CONTEXT=$(dirname "$DOCKERFILE")
fi

if [ ! -f "$DOCKERFILE" ]; then
  echo "Error: Dockerfile not found: $DOCKERFILE" >&2
  exit 1
fi

# --- branch guard ---

DEFAULT_BRANCH=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's@^origin/@@')
[ -n "$DEFAULT_BRANCH" ] || DEFAULT_BRANCH=main

CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [ "$CURRENT_BRANCH" != "$DEFAULT_BRANCH" ]; then
  if [ "$FORCE_OTHER_BRANCH" -ne 1 ]; then
    echo "Warning: on '$CURRENT_BRANCH', not default '$DEFAULT_BRANCH'. Pass --force-other-branch to proceed." >&2
    exit 1
  fi
  echo "Warning: releasing from non-default branch '$CURRENT_BRANCH' (--force-other-branch)."
fi

# --- dirty guard ---

if ! git diff --quiet HEAD -- || [ -n "$(git ls-files --others --exclude-standard)" ]; then
  if [ "$FORCE_DIRTY" -ne 1 ]; then
    echo "Error: working tree has uncommitted or untracked changes. Commit first, or pass --force-dirty." >&2
    git status --short >&2
    exit 1
  fi
  echo "Warning: releasing with dirty working tree (--force-dirty)."
fi

# --- base version resolution ---

LEGACY_FILE="release-$PROJECT.txt"
FROM_FILE=0
BASE_VERSION=""

if [ -f "$LEGACY_FILE" ]; then
  BASE_VERSION=$(cat "$LEGACY_FILE")
  FROM_FILE=1
  if ! echo "$BASE_VERSION" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+$'; then
    echo "Invalid $LEGACY_FILE contents: $BASE_VERSION" >&2
    exit 1
  fi
  echo "Base version from $LEGACY_FILE: $BASE_VERSION (will be deleted after release)"
else
  BASE_VERSION=$(git tag --merged "$DEFAULT_BRANCH" -l "$PROJECT/v[0-9]*.[0-9]*.[0-9]*" \
    | sed "s@^$PROJECT/v@@" \
    | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' \
    | sort -t. -k1,1n -k2,2n -k3,3n \
    | tail -n1)
  if [ -n "$BASE_VERSION" ]; then
    echo "Base version from largest $PROJECT/v* tag on '$DEFAULT_BRANCH': $BASE_VERSION"
  else
    printf "No %s, no %s/vX.Y.Z tag found. Enter base version (X.Y.Z): " "$LEGACY_FILE" "$PROJECT"
    read -r BASE_VERSION
    if ! echo "$BASE_VERSION" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+$'; then
      echo "Invalid version: $BASE_VERSION" >&2
      exit 1
    fi
  fi
fi

MAJOR=$(echo "$BASE_VERSION" | cut -d. -f1)
MINOR=$(echo "$BASE_VERSION" | cut -d. -f2)
PATCH=$(echo "$BASE_VERSION" | cut -d. -f3)

case "$BUMP" in
  major) MAJOR=$((MAJOR + 1)); MINOR=0; PATCH=0 ;;
  minor) MINOR=$((MINOR + 1)); PATCH=0 ;;
  patch) PATCH=$((PATCH + 1)) ;;
esac

VERSION="$MAJOR.$MINOR.$PATCH"
TAG="$PROJECT/v$VERSION"

if git rev-parse -q --verify "refs/tags/$TAG" >/dev/null; then
  echo "Error: tag $TAG already exists." >&2
  exit 1
fi

IMAGE_LOCAL="$CONTAINER:$VERSION"
IMAGE_REMOTE="$REGISTRY_HOST/$NAMESPACE/$CONTAINER:$VERSION"

echo "Releasing $PROJECT $VERSION (bump: $BUMP, base: $BASE_VERSION)"
echo "  dockerfile: $DOCKERFILE"
echo "  context:    $CONTEXT"
echo "  image:      $IMAGE_REMOTE"

# --- build/tag/push ---

podman build --squash --compress --no-cache -f "$DOCKERFILE" -t "$IMAGE_LOCAL" "$CONTEXT"
podman tag "$IMAGE_LOCAL" "$IMAGE_REMOTE"
podman push "$IMAGE_REMOTE"

# --- post ---

git tag "$TAG"
echo "Tagged HEAD as $TAG. Push with: git push origin $TAG"

if [ "$FROM_FILE" -eq 1 ]; then
  rm "$LEGACY_FILE"
  echo "Removed legacy $LEGACY_FILE (superseded by git tags)."
fi
