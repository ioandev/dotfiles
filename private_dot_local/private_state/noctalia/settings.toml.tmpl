config_version = 2

[bar.default]
background_opacity = 0.669999985024333
capsule_thickness = 0.7799999862909317
center = [ "clock", "custom_button_2", "sysmon", "cpu-bars", "tray", "workspaces", "taskbar", "custom_button_3" ]
color = "primary"
end = [
    "media",
    "tray",
    "notifications",
    "clipboard",
    "network",
    "bluetooth",
    "volume",
    "brightness",
    "battery",
    "session",
    "clock",
    "date",
    "control-center"
]
icon_color = "secondary"
margin_ends = 5
padding = 0
panel_overlap = 2
position = "bottom"
radius = 0
radius_top_left = 0
radius_top_right = 0
start = [ "control-center", "launcher", "wallpaper", "workspaces", "group:g2", "media" ]

    [[bar.default.capsule_group]]
    enabled = true
    fill = "surface_variant"
    id = "g2"
    members = [ "clock", "date" ]
    opacity = 1.0
    padding = 6.0

[dock]
background_opacity = 0.99999997764825821
icon_size = 16
main_axis_padding = 6
radius = 80

[lockscreen_widgets]
enabled = false
schema_version = 2
widget_order = [ "lockscreen-login-box@Virtual-1" ]

    [lockscreen_widgets.grid]
    cell_size = 16
    major_interval = 4
    visible = true

    [lockscreen_widgets.widget."lockscreen-login-box@Virtual-1"]
    box_height = 70.0
    box_width = 400.0
    cx = 1720.0
    cy = 1321.0
    output = "Virtual-1"
    rotation = 0.0
    type = "login_box"

        [lockscreen_widgets.widget."lockscreen-login-box@Virtual-1".settings]
        background_color = "surface_variant"
        background_opacity = 0.88
        background_radius = 12.0
        center_password_text = false
        input_opacity = 1.0
        input_radius = 6.0
        show_caps_lock = true
        show_keyboard_layout = true
        show_login_button = true
        show_password_hint = true

[osd]
position = "bottom_center"
position_vertical = "bottom_center"

[plugins]
enabled = [ "ioandev/cpu-bars" ]

    [[plugins.source]]
    kind = "git"
    location = "https://github.com/noctalia-dev/official-plugins"
    name = "official"

    [[plugins.source]]
    kind = "git"
    location = "https://github.com/noctalia-dev/community-plugins"
    name = "community"

    [[plugins.source]]
    kind = "path"
    location = "{{ .chezmoi.homeDir }}/.local/share/noctalia-dev-plugins"
    name = "devlocal"

[shell]
clipboard_enabled = false
telemetry_enabled = true

    [shell.animation]
    speed = 1.1000000163912773

    [shell.panel]
    launcher_position = "auto"

# Per-profile color scheme, carried over from the v4 split: the VM stays visually
# distinct from the physical machine. "Ember Red" is a custom palette shipped in
# ~/.config/noctalia/palettes/ (ported from the v4 colorschemes/ dir); "Ayu" is a
# v5 builtin. v5 has no "Gruber Darker" builtin, so full tracks the live setup.
[theme]
mode = "dark"
{{ if eq .profile "guest" -}}
source = "custom"
custom_palette = "Ember Red"
{{ else -}}
source = "builtin"
builtin = "Ayu"
{{ end -}}
wallpaper_scheme = "m3-content"

[wallpaper]
directory = "{{ .chezmoi.homeDir }}/Pictures/Wallpapers"

    [wallpaper.default]
    path = "{{ .chezmoi.homeDir }}/Pictures/Wallpapers/christian-joudrey-mWRR1xj95hg-unsplash.jpg"

    [wallpaper.last]
    path = "{{ .chezmoi.homeDir }}/Pictures/Wallpapers/christian-joudrey-mWRR1xj95hg-unsplash.jpg"

    [wallpaper.monitors.Virtual-1]
    path = "{{ .chezmoi.homeDir }}/Pictures/Wallpapers/christian-joudrey-mWRR1xj95hg-unsplash.jpg"

[widget.bluetooth]
enabled = false

[widget.clipboard]
enabled = false

[widget.clock]
format = "{:%-I:%M %p}"

[widget.cpu-bars]
bar_gap = 3
capsule = true
type = "ioandev/cpu-bars:cpu-bars"

[widget.custom_button_2]
type = "custom_button"

[widget.custom_button_3]
command = "noctalia msg wallpaper-random"
glyph = "hdr"
tooltip = "Do not press"
type = "custom_button"

[widget.network]
enabled = false

[widget.sysmon]
display = "graph"
enabled = false

[widget.taskbar]
color = "tertiary"
group_by_workspace = true
icon_color = "on_primary"
show_window_title = true
window_title_max_width = 72
workspace_label_placement = "inside"
workspace_label_size = 9

[widget.tray]
enabled = false

[widget.workspaces]
enabled = false
